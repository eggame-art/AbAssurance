ARG PYTHON_IMAGE=python:3.11-bookworm
FROM ${PYTHON_IMAGE}

RUN python --version && python -m pip --version

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless ca-certificates curl unixodbc-dev \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
        -o /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -rf /var/lib/apt/lists/* /tmp/packages-microsoft-prod.deb

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN python -m pip install --no-cache-dir -e ".[dev,spark]"

ENV PYSPARK_PYTHON=python3 SPARK_LOCAL_IP=127.0.0.1
CMD ["python", "-m", "spark_pipeline.run"]
