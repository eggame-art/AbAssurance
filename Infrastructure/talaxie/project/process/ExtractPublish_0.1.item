  <node componentName="tJava" componentVersion="0.102" posX="120" posY="380">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_Setup"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="context.oracleHost = routines.AbAssuranceKafka.env(&quot;ORACLE_HOST&quot;, &quot;oracle&quot;);&#10;context.oraclePort = routines.AbAssuranceKafka.env(&quot;ORACLE_PORT&quot;, &quot;1521&quot;);&#10;context.oracleService = routines.AbAssuranceKafka.env(&quot;ORACLE_SERVICE&quot;, &quot;FREEPDB1&quot;);&#10;context.oracleUser = routines.AbAssuranceKafka.env(&quot;ORACLE_USER&quot;, &quot;ABASSURANCE&quot;);&#10;context.oraclePassword = routines.AbAssuranceKafka.required(&quot;ORACLE_APP_PASSWORD&quot;, null);&#10;context.sqlserverHost = routines.AbAssuranceKafka.env(&quot;SQLSERVER_HOST&quot;, &quot;sqlserver&quot;);&#10;context.sqlserverPort = routines.AbAssuranceKafka.env(&quot;SQLSERVER_PORT&quot;, &quot;1433&quot;);&#10;context.sqlserverDatabase = routines.AbAssuranceKafka.env(&quot;SQLSERVER_DATABASE&quot;, &quot;AssurePlus&quot;);&#10;context.sqlserverUser = routines.AbAssuranceKafka.env(&quot;SQLSERVER_USER&quot;, &quot;sa&quot;);&#10;context.sqlserverPassword = routines.AbAssuranceKafka.required(&quot;SQLSERVER_PASSWORD&quot;, &quot;MSSQL_SA_PASSWORD&quot;);&#10;int connectionTimeout = routines.AbAssuranceKafka.timeout(&quot;DB_CONNECT_TIMEOUT&quot;, 10);&#10;context.oracleProperties = &quot;oracle.net.CONNECT_TIMEOUT=&quot; + connectionTimeout * 1000;&#10;context.sqlserverProperties = &quot;encrypt=&quot; + routines.AbAssuranceKafka.jdbcBoolean(&quot;SQLSERVER_ENCRYPT&quot;, &quot;yes&quot;) + &quot;;trustServerCertificate=&quot; + routines.AbAssuranceKafka.jdbcBoolean(&quot;SQLSERVER_TRUST_CERTIFICATE&quot;, &quot;no&quot;) + &quot;;loginTimeout=&quot; + connectionTimeout;&#10;globalMap.put(&quot;publisher&quot;, new routines.AbAssuranceKafka());"/>

  </node>
