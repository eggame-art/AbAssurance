<?xml version='1.0' encoding='utf-8'?>
<workflow>
  <name>integrate</name>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </action>
    <action>
      <name>abassurance_customers</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/abassurance_customers.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>220</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>abassurance_contracts</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/abassurance_contracts.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>290</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>abassurance_claims</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/abassurance_claims.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>360</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>abassurance_payments</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/abassurance_payments.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>430</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>assureplus_customers</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/assureplus_customers.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>500</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>assureplus_contracts</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/assureplus_contracts.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>570</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>assureplus_claims</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/assureplus_claims.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>640</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>assureplus_payments</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/pipelines/assureplus_payments.hpl</filename>
      <run_configuration>local</run_configuration>
      <wait_until_finished>Y</wait_until_finished>
      <set_logfile>N</set_logfile>
      <xloc>300</xloc>
      <yloc>710</yloc>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>abassurance_customers</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>abassurance_customers</from>
      <to>abassurance_contracts</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>abassurance_contracts</from>
      <to>abassurance_claims</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>abassurance_claims</from>
      <to>abassurance_payments</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>abassurance_payments</from>
      <to>assureplus_customers</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>assureplus_customers</from>
      <to>assureplus_contracts</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>assureplus_contracts</from>
      <to>assureplus_claims</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>assureplus_claims</from>
      <to>assureplus_payments</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
</workflow>